{
  // rhythm-game. The Worker's name must match the one in the Cloudflare dashboard.
  "name": "rhythm-game",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // the page (public/). /api/* goes to the Worker code first: /api/today asks Beat Fighter for today's song.
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*"] }
}
